# GEMINI_API_KEY: Required for Gemini AI video understanding API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for rich video metadata & exact ISO duration.
# When omitted, Highlight falls back to official YouTube oEmbed metadata + user/source duration verification.
YOUTUBE_API_KEY="MY_YOUTUBE_DATA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STORAGE_DIR: Local or mounted cloud storage directory for authorized video uploads and rendered MP4 reels.
STORAGE_DIR="/tmp/highlight-storage"

