# Server-side only. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=MY_GEMINI_API_KEY
# Override if your account uses a different video-capable model.
GEMINI_MODEL=gemini-3.8-flash

# Optional: YouTube Data API v3 key for metadata. Leave blank to use public metadata.
YOUTUBE_API_KEY=

# Persist BOTH database and media here. Use /app/storage on Render/Docker.
STORAGE_DIR=/tmp/highlight-storage
# Only set this to place media on a separate persistent volume.
# MEDIA_STORAGE_DIR=/tmp/highlight-storage

# Default: fail clearly if Gemini is unavailable. Optional audio/timing-only mode.
ALLOW_HEURISTIC_FALLBACK=false
ENABLE_DEV_FIXTURES=false

# Optional overrides. Docker supplies these automatically.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YT_DLP_BIN=/usr/local/bin/yt-dlp
PORT=3000
